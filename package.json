{
  "name": "ropa-onecore",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "onecore": "onecore",
    "deploy:preview": "npm run skill:upstream && vercel build && vercel deploy --prebuilt",
    "deploy": "npm run skill:upstream && vercel build --prod && vercel deploy --prebuilt --prod",
    "skill:parity": "node scripts/skill-parity.mjs",
    "skill:upstream": "node scripts/skill-upstream.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "21.1.6",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@onetrust/onecore": "0.7.0",
    "cfb": "1.2.2",
    "fflate": "0.8.2",
    "ng-primitives": "0.131.0",
    "pdfjs-dist": "5.7.284",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
